{
  "name": "cellarpos",
  "version": "1.1.0",
  "description": "CellarPOS wines & spirits POS",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test.mjs",
    "desktop": "electron .",
    "dist": "electron-builder",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "@electron/rebuild": "^3.7.0"
  },
  "build": {
    "appId": "com.yobbytech.cellarpos",
    "productName": "CellarPOS",
    "files": [
      "desktop/**",
      "server.js",
      "extra.js",
      "manage.js",
      "db.js",
      "lib/**",
      "public/**",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}