# Copy to /etc/cellarpos.env and fill in. Keep this file private (chmod 640).
NODE_ENV=production
PORT=3000
DB=/var/lib/cellarpos/pos.db
BACKUP_DIR=/var/lib/cellarpos/backups
TRUST_PROXY=1
PUBLIC_URL=https://shop.example.com

# Encryption key for API secrets saved in Settings (M-Pesa, Cloudinary). If unset, a key file is created next to the database; BACK IT UP.
SETTINGS_KEY=
# Product photos stored on this server (default: an 'uploads' folder next to the database)
UPLOAD_DIR=/var/lib/cellarpos/uploads

# M-Pesa: the owner now enters these in Settings → Payments. The variables below are only a fallback.
# (leave MPESA_KEY empty to stay in MOCK mode)
MPESA_ENV=production
MPESA_KEY=
MPESA_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TYPE=CustomerPayBillOnline
MPESA_TILL=

# Receipt printer: network (PRINTER_HOST) or USB/shared device (PRINTER_DEVICE)
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_DEVICE=

# SMS (Africa's Talking). Leave empty for MOCK
SMS_PROVIDER=
AT_USER=
AT_KEY=
AT_ENV=production
SMS_SENDER=

# Fiscal: mock until a certified eTIMS adapter is configured (receipts are then NOT KRA invoices)
FISCAL=mock
